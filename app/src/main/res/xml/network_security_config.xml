<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only, and only certificates from the phone's built-in authorities
     (certificates added by other apps or users are not trusted). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
